{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "SMARTFOX IP / Host"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port"
    },
    {
      "type": "NumberSpinner",
      "name": "UnitID",
      "caption": "Unit ID"
    },
    {
      "type": "NumberSpinner",
      "name": "UpdateInterval",
      "caption": "Aktualisierung (Sekunden)"
    },
    {
      "type": "List",
      "name": "Registers",
      "caption": "Register",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "columns": [
        {
          "caption": "Aktiv",
          "name": "Enabled",
          "width": "60px",
          "add": true,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Name",
          "name": "Name",
          "width": "180px",
          "add": "PV Power",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Ident",
          "name": "Ident",
          "width": "140px",
          "add": "PVPower",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Adresse",
          "name": "Address",
          "width": "90px",
          "add": 96,
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "caption": "Typ",
          "name": "Type",
          "width": "100px",
          "add": "int32",
          "edit": {
            "type": "Select",
            "options": [
              {"caption": "uint16", "value": "uint16"},
              {"caption": "int16", "value": "int16"},
              {"caption": "uint32", "value": "uint32"},
              {"caption": "int32", "value": "int32"},
              {"caption": "float32", "value": "float32"}
            ]
          }
        },
        {
          "caption": "Zugriff",
          "name": "Access",
          "width": "70px",
          "add": "R",
          "edit": {
            "type": "Select",
            "options": [
              {"caption": "R", "value": "R"},
              {"caption": "RW", "value": "RW"}
            ]
          }
        },
        {
          "caption": "Faktor",
          "name": "Factor",
          "width": "80px",
          "add": 1,
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "caption": "Profil",
          "name": "Profile",
          "width": "120px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "WordOrder",
          "name": "WordOrder",
          "width": "100px",
          "add": "AB",
          "edit": {
            "type": "Select",
            "options": [
              {"caption": "AB (Standard)", "value": "AB"},
              {"caption": "BA (Swap)", "value": "BA"}
            ]
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "SMARTFOX_Update($id);"
    }
  ],
  "status": [
    {"code": 101, "icon": "inactive", "caption": "Wird erstellt"},
    {"code": 102, "icon": "active", "caption": "Aktiv"},
    {"code": 104, "icon": "inactive", "caption": "Inaktiv"},
    {"code": 200, "icon": "error", "caption": "Verbindung fehlgeschlagen"},
    {"code": 201, "icon": "error", "caption": "Konfiguration fehlerhaft"}
  ]
