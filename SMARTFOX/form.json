{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "SMARTFOX IP / Host"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port"
    },
    {
      "type": "NumberSpinner",
      "name": "UnitID",
      "caption": "Unit-ID"
    },
    {
      "type": "Select",
      "name": "AddressBase",
      "caption": "Adressbasis aus Dokumentation",
      "options": [
        {
          "caption": "40000 (SMARTFOX Register wie 41012 -> gesendet wird 1012)",
          "value": 40000
        },
        {
          "caption": "0 (Adresse wird exakt wie eingetragen gesendet)",
          "value": 0
        }
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "UpdateInterval",
      "caption": "Aktualisierung (Sekunden)"
    },
    {
      "type": "List",
      "name": "RegisterConfig",
      "caption": "Register",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "sort": {
        "column": "Address",
        "direction": "ascending"
      },
      "columns": [
        {
          "caption": "Aktiv",
          "name": "Enabled",
          "width": "60px",
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "caption": "Adresse",
          "name": "Address",
          "width": "80px",
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "caption": "Name",
          "name": "Name",
          "width": "220px",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Ident",
          "name": "Ident",
          "width": "160px",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Typ",
          "name": "Type",
          "width": "90px",
          "edit": {
            "type": "Select",
            "options": [
              {"caption": "bool", "value": "bool"},
              {"caption": "uint8", "value": "uint8"},
              {"caption": "uint16", "value": "uint16"},
              {"caption": "int16", "value": "int16"},
              {"caption": "uint32", "value": "uint32"},
              {"caption": "int32", "value": "int32"},
              {"caption": "uint64", "value": "uint64"},
              {"caption": "float32", "value": "float32"},
              {"caption": "uint8[6]", "value": "uint8[6]"},
              {"caption": "string", "value": "string"}
            ]
          }
        },
        {
          "caption": "Länge",
          "name": "Length",
          "width": "60px",
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "caption": "Zugriff",
          "name": "Access",
          "width": "70px",
          "edit": {
            "type": "Select",
            "options": [
              {"caption": "R", "value": "R"},
              {"caption": "RW", "value": "RW"}
            ]
          }
        },
        {
          "caption": "Skalierung",
          "digits": 3,
          "step": 0.001
          "name": "Scale",
          "width": "80px",
          "edit": {
            "type": "NumberSpinner"
          }
        },
        {
          "caption": "Einheit",
          "name": "Unit",
          "width": "70px",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "caption": "Beschreibung",
          "name": "Description",
          "width": "250px",
          "edit": {
            "type": "ValidationTextBox"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "SMARTFOX_Update($id);"
    },
    {
      "type": "Label",
      "caption": "Hinweis: Für die SMARTFOX-Tabelle ist normalerweise Adressbasis 40000 korrekt. Beispiel: 41012 in der Tabelle wird intern als 1012 gelesen."
    }
  ]
}
